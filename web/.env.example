# Copy to .env.local for development. Nothing here is secret: these values end up in the page.

# The team backend (src/backend): /resolve for names and coordinates, /stars for Gaia DR3.
# Development: http://localhost:8000 when run with `uv run uvicorn main:app` in src/backend.
VITE_TEAM_API_URL=

# The frames engine (api/). Leave empty when the site and the engine share one origin (/api is proxied).
VITE_ENGINE_URL=
